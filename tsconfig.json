{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Type-check and test against the sources, so no build is needed first.
    "paths": {
      "@minamojs/minamo": ["./packages/core/src/index.ts"],
      "@minamojs/minamo/memory": ["./packages/core/src/memory.ts"],
      "@minamojs/lambda-df": ["./packages/lambda-df/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "test/**/*.ts"]
}
